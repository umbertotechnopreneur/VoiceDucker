<Window
    x:Class="VoiceDucker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoiceDucker.Controls"
    Title="VoiceDucker">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
    <SplitView x:Name="SettingsSplitView" PanePlacement="Right" DisplayMode="Inline"
               OpenPaneLength="520" IsPaneOpen="False" PaneBackground="Transparent">
        <SplitView.Resources>
            <!-- Derived controls need the explicit current WinUI Slider style. -->
            <Style x:Key="VoiceDuckerSliderStyle" TargetType="controls:ScrollSafeSlider"
                   BasedOn="{StaticResource DefaultSliderStyle}" />
        </SplitView.Resources>
        <SplitView.Pane>
            <Border BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsPanel" Padding="12" Spacing="4">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="4,4,0,8" />
                        <StackPanel Margin="4,0,4,12" Spacing="2">
                            <TextBlock Text="Need help with the parameters?" FontSize="13" TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="SettingsHelpLink" Content="Visit our online tutorial and parameter guide."
                                             NavigateUri="https://umbertogiacobbi.biz/voiceducker/guide/?utm_source=voiceducker&amp;utm_medium=referral&amp;utm_campaign=in_app_help&amp;utm_content=settings_parameters"
                                             HorizontalAlignment="Left" Padding="0" MinHeight="0" FontSize="13"
                                             AutomationProperties.Name="Open the online VoiceDucker parameter guide" />
                        </StackPanel>
            <Expander x:Name="ProfilesExpander" Header="Manual profiles"
                      IsExpanded="False" MinHeight="40" Padding="12" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Expanding="SettingsExpander_Expanding">
                <StackPanel Spacing="12">
                    <TextBlock Text="Choose one of five presets or save your own listening settings. Use Save as new to customize a preset. Profiles never enable the microphone or change startup options or the selected input."
                               TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                    <ComboBox x:Name="SettingsProfileComboBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                              SelectionChanged="ProfileComboBox_SelectionChanged" AutomationProperties.Name="Manage listening profile" />
                    <TextBlock x:Name="SettingsProfileHintText" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                    <TextBox x:Name="ProfileNameBox" Header="Profile name" PlaceholderText="e.g. Talking to AI"
                             AutomationProperties.Name="New or renamed profile name" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="Save as new" Click="SaveProfile_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="UpdateProfileButton" Grid.Column="1" Content="Update saved" Click="UpdateProfile_Click"
                                HorizontalAlignment="Stretch" ToolTipService.ToolTip="Replace the selected profile with your current listening settings" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RenameProfileButton" Content="Rename" Click="RenameProfile_Click" />
                        <Button x:Name="DeleteProfileButton" Content="Delete…">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="12" MaxWidth="260">
                                        <TextBlock Text="Delete the selected saved profile? Current listening settings will stay active."
                                                   TextWrapping="Wrap" />
                                        <Button Content="Delete profile" Click="DeleteProfile_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Includes reduction, fade times and curve, detection settings and other-app playback. Hidden apps are global and stay hidden when you change profiles. Changes are saved to a profile only when you choose Update saved."
                               TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                </StackPanel>
            </Expander>

            <Expander x:Name="DetectionExpander" Header="Microphone &amp; detection"
                      IsExpanded="False" MinHeight="40" Padding="12" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Expanding="SettingsExpander_Expanding">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sensitivity" VerticalAlignment="Center" />
                            <TextBlock x:Name="SensitivityValueText" Grid.Column="1"
                                       VerticalAlignment="Center" FontFamily="Consolas" />
                            <Button Grid.Column="2" Content="Reset" Click="SensitivityReset_Click"
                                    Padding="10,4" AutomationProperties.Name="Reset microphone sensitivity" />
                        </Grid>
                        <controls:ScrollSafeSlider x:Name="SensitivitySlider"
                                StepFrequency="1" HorizontalAlignment="Stretch"
                                Style="{StaticResource VoiceDuckerSliderStyle}" Loaded="SettingSlider_Loaded"
                                ValueChanged="SensitivitySlider_ValueChanged"
                                AutomationProperties.Name="Microphone sensitivity in decibels">
                            <controls:ScrollSafeSlider.Resources>
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#7AD66D" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#94E889" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#62BC57" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#7AD66D" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#94E889" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#62BC57" />
                            </controls:ScrollSafeSlider.Resources>
                        </controls:ScrollSafeSlider>
                        <TextBlock Text="Microphone gain after capture: more dB detects quieter sounds. Applies only to VoiceDucker."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detection threshold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ThresholdValueText" Grid.Column="1"
                                       VerticalAlignment="Center" FontFamily="Consolas" />
                            <Button Grid.Column="2" Content="Reset" Click="ThresholdReset_Click"
                                    Padding="10,4" AutomationProperties.Name="Reset detection threshold" />
                        </Grid>
                        <controls:ScrollSafeSlider x:Name="ThresholdSlider"
                                StepFrequency="0.1" HorizontalAlignment="Stretch"
                                Style="{StaticResource VoiceDuckerSliderStyle}" Loaded="SettingSlider_Loaded"
                                ValueChanged="ThresholdSlider_ValueChanged"
                                AutomationProperties.Name="Detection threshold in dBFS" />
                        <TextBlock Text="This controls when lowering starts. Lower values detect quieter sounds. Reduce volume by controls how much playback is lowered. The microphone meter marks this threshold after Sensitivity gain."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hysteresis (dB)" VerticalAlignment="Center" />
                            <NumberBox x:Name="HysteresisBox" Grid.Column="1"
                                       SmallChange="1" SpinButtonPlacementMode="Compact"
                                       Loaded="SettingBox_Loaded" ValueChanged="SettingBox_ValueChanged"
                                       AutomationProperties.Name="Detection hysteresis in decibels" />
                        </Grid>
                        <TextBlock Text="Keeps detection active through small dips below the threshold. Set to zero to disable."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                        <TextBlock x:Name="ReleaseThresholdText" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Microphone" />
                        <ComboBox x:Name="MicrophoneComboBox" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Name" SelectionChanged="MicrophoneComboBox_SelectionChanged"
                                  DropDownOpened="MicrophoneComboBox_DropDownOpened"
                                  AutomationProperties.Name="Choose microphone" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="VolumeExpander" Header="Volume &amp; timing"
                      IsExpanded="False" MinHeight="40" Padding="12" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Expanding="SettingsExpander_Expanding">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Reduce volume by (%)" VerticalAlignment="Center" />
                            <NumberBox x:Name="ReductionBox" Grid.Column="1"
                                       SmallChange="1" SpinButtonPlacementMode="Compact"
                                       Loaded="SettingBox_Loaded" ValueChanged="SettingBox_ValueChanged" />
                            <TextBlock Grid.Row="1" Text="Fade down (ms)" VerticalAlignment="Center" />
                            <NumberBox x:Name="FadeDownBox" Grid.Row="1" Grid.Column="1"
                                       SmallChange="100" SpinButtonPlacementMode="Compact"
                                       Loaded="SettingBox_Loaded" ValueChanged="SettingBox_ValueChanged" />
                            <TextBlock Grid.Row="2" Text="Wait before fade back (ms)" VerticalAlignment="Center" />
                            <NumberBox x:Name="RestoreDelayBox" Grid.Row="2" Grid.Column="1"
                                       SmallChange="100" SpinButtonPlacementMode="Compact"
                                       Loaded="SettingBox_Loaded" ValueChanged="SettingBox_ValueChanged" />
                            <TextBlock Grid.Row="3" Text="Fade back (ms)" VerticalAlignment="Center" />
                            <NumberBox x:Name="FadeUpBox" Grid.Row="3" Grid.Column="1"
                                       SmallChange="100" SpinButtonPlacementMode="Compact"
                                       Loaded="SettingBox_Loaded" ValueChanged="SettingBox_ValueChanged" />
                        </Grid>
                        <TextBlock Text="Wait keeps music quiet through short pauses. Fade back is the time to return to the previous volume."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                        <CheckBox x:Name="SmoothTransitionsCheckBox" Content="Softer transitions"
                                  Click="SmoothTransitions_Click" />
                        <TextBlock Text="Ease into and out of automatic volume changes, using the same fade times. Turn off for linear fades."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="AppsExpander" Header="Apps &amp; startup"
                      IsExpanded="False" MinHeight="40" Padding="12" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Expanding="SettingsExpander_Expanding">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="OtherSourcesCheckBox" Content="Also lower other apps"
                                  VerticalAlignment="Center" Click="OtherSourcesCheckBox_Click" />
                        <Button x:Name="HiddenAppsButton" Grid.Column="1" Content="Hidden apps"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Width="280" Spacing="12">
                                        <TextBlock Text="Hidden apps" FontWeight="SemiBold" />
                                        <TextBlock Text="Hidden apps are not listed or automatically lowered. Use the X to show an app again."
                                                   TextWrapping="Wrap" FontSize="12" Opacity="0.72" />
                                        <TextBlock x:Name="NoHiddenAppsText" Text="No hidden apps." />
                                        <ListView x:Name="HiddenAppsList" MaxHeight="280"
                                                  SelectionMode="None" IsItemClickEnabled="False"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="Hidden apps">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <StackPanel Spacing="8">
                        <CheckBox x:Name="StartupCheckBox" Content="Start with Windows"
                                  Click="StartupCheckBox_Click" />
                        <CheckBox x:Name="StartupMicrophoneCheckBox" Content="Enable microphone on startup"
                                  Click="StartupMicrophoneCheckBox_Click" />
                        <TextBlock Text="Start monitoring whenever VoiceDucker opens, including manual launches. Off by default and independent of Start with Windows. Applies on the next launch."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </StackPanel>
            </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </SplitView.Pane>
    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Enabled" HorizontalContentAlignment="Stretch"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="RootPanel" Padding="22,0,22,22" RowSpacing="16"
          MinHeight="{Binding ViewportHeight, ElementName=MainScrollViewer}">
        <Grid.Resources>
            <Style x:Key="PlaybackLevelMeterStyle" TargetType="ProgressBar">
                <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="16">
            <InfoBar x:Name="ExistingInstanceNotice" IsOpen="False" IsClosable="True"
                     Severity="Informational" Title="VoiceDucker is already running"
                     Message="Only one instance can run at a time. This is your existing window." />
            <Border x:Name="LicensePanel" Visibility="Collapsed" Padding="12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Check license" Click="CheckLicense_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="164" Height="164" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="MixerScale" CenterX="82" CenterY="82" />
                        </Grid.RenderTransform>
                        <Image x:Name="MixerImage" Source="Assets/voice-mixer-off.png"
                               Stretch="UniformToFill" Opacity="0.65" />
                        <Image x:Name="MixerOnImage" Source="Assets/voice-mixer.png"
                               Stretch="UniformToFill" Opacity="0">
                            <Image.Clip>
                                <RectangleGeometry Rect="62,39,42,21" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <Border x:Name="MicGlow" CornerRadius="12" BorderThickness="3"
                            BorderBrush="#F6A24C" Opacity="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Margin="0,0,0,9" Spacing="3">
                        <Border x:Name="Bar1" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar2" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar3" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar4" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar5" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                    </StackPanel>
                </Grid>
                    <ToggleButton x:Name="SettingsButton" Grid.Column="2" Click="SettingsButton_Click"
                                  Background="Transparent" BorderThickness="0" Padding="4"
                                  MinWidth="28" MinHeight="28" VerticalAlignment="Top"
                                  AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                        <ToggleButton.Resources>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                        </ToggleButton.Resources>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="20" />
                    </ToggleButton>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                    <TextBlock x:Name="VisualStateText" Text="MIC OFF" FontFamily="Consolas"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Off. Your microphone is not in use."
                               TextWrapping="Wrap" FontSize="13" />
                    <TextBlock x:Name="MicrophoneNameText" Text="Microphone: Windows default"
                               TextWrapping="Wrap" FontSize="12" Opacity="0.72" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="5">
                <Grid>
                    <TextBlock Text="MIC LEVEL" FontFamily="Consolas" FontSize="12" />
                    <TextBlock x:Name="MicrophoneLevelText" Text="Off" HorizontalAlignment="Right"
                               FontFamily="Consolas" FontSize="12" />
                </Grid>
                <Grid Height="28">
                    <Border Height="18" VerticalAlignment="Center" Background="#203B2A"
                            BorderBrush="#537A5C" BorderThickness="1" CornerRadius="4">
                        <Grid x:Name="MicrophoneMeter"
                              AutomationProperties.Name="Microphone level after sensitivity gain">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MicrophoneLevelColumn" Width="0*" />
                                <ColumnDefinition x:Name="MicrophoneEmptyColumn" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#7AD66D" CornerRadius="3" />
                        </Grid>
                    </Border>
                    <Grid IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ThresholdBeforeColumn" />
                            <ColumnDefinition x:Name="ThresholdAfterColumn" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Width="2" HorizontalAlignment="Left" Background="#FFF4DC"
                                ToolTipService.ToolTip="Sound above this threshold lowers playback" />
                    </Grid>
                </Grid>
                <Grid>
                    <TextBlock x:Name="MicrophoneMeterMinimumText" FontFamily="Consolas" FontSize="11" Opacity="0.65" />
                    <TextBlock x:Name="MicrophoneThresholdText"
                               ToolTipService.ToolTip="Adjust Detection threshold in Microphone &amp; detection"
                               HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11" Opacity="0.8" />
                    <TextBlock x:Name="MicrophoneMeterMaximumText" HorizontalAlignment="Right" FontFamily="Consolas"
                               FontSize="11" Opacity="0.65" />
                </Grid>
                <TextBlock x:Name="MicrophoneLevelHint" Text="Press Enable to see your microphone level."
                           FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Listening profile" VerticalAlignment="Center" />
                    <ComboBox x:Name="ProfileComboBox" Grid.Column="1" DisplayMemberPath="Name"
                              HorizontalAlignment="Stretch" SelectionChanged="ProfileComboBox_SelectionChanged"
                              AutomationProperties.Name="Listening profile" />
                </Grid>
                <TextBlock x:Name="ProfileHintText" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ToggleButton" Click="ToggleButton_Click"
                        HorizontalAlignment="Stretch" MinHeight="46"
                        Background="#346A9C" Foreground="#FFF4DC">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="ToggleButtonIcon" Glyph="&#xE768;"
                                  FontFamily="Segoe Fluent Icons" FontSize="16" />
                        <TextBlock x:Name="ToggleButtonLabel" Text="Enable" />
                    </StackPanel>
                </Button>
                <Button x:Name="PauseButton" Grid.Column="1" Width="46" Height="46"
                        Margin="8,0,0,0" Padding="0" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        AutomationProperties.Name="Pause monitoring"
                        AutomationProperties.HelpText="Pause microphone monitoring, then resume automatically."
                        ToolTipService.ToolTip="Pause microphone monitoring, then resume automatically.">
                    <FontIcon Glyph="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="16"
                              AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>
            <Border x:Name="PausedPanel" Visibility="Collapsed" Padding="12" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PauseCountdownText" VerticalAlignment="Center" FontFamily="Consolas" />
                        <Button x:Name="ResumeButton" Grid.Column="1" Content="Resume now" Click="Resume_Click" />
                    </Grid>
                    <TextBlock Text="Microphone off. Monitoring resumes when the timer ends. Disable cancels the timer."
                               TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                </StackPanel>
            </Border>

            <Expander x:Name="AudioStreamsExpander" Header="Active audio streams"
                      IsExpanded="True" MinHeight="40" Padding="12" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sliders show current volume; Normal is the level after speech. Each orange meter shows its session's output. Choose which apps to lower in Apps &amp; startup."
                               TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                    <StackPanel x:Name="StreamRows" Spacing="8" />
                    <TextBlock x:Name="NoStreamsText" Text="No apps playing audio right now."
                               FontSize="12" Opacity="0.68" />
                </StackPanel>
            </Expander>

            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="12" />

        </StackPanel>
            <StackPanel Grid.Row="1" Spacing="12">
                <StackPanel x:Name="FooterPurchasePanel" Visibility="Collapsed"
                            Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="FooterTrialText" Text="You're using the trial version"
                               FontSize="11" VerticalAlignment="Center" />
                    <HyperlinkButton Content="Purchase" Padding="0" FontSize="12"
                                     Click="Purchase_Click" />
                </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="About VoiceDucker" Click="AboutButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="0" FontSize="12" />
                <TextBlock Text="·" VerticalAlignment="Center" />
                <HyperlinkButton Content="Terms" NavigateUri="https://umbertogiacobbi.biz/terms/"
                                 Padding="0" FontSize="12" />
                <TextBlock Text="·" VerticalAlignment="Center" />
                <HyperlinkButton Content="Privacy" NavigateUri="https://umbertogiacobbi.biz/privacy/"
                                 Padding="0" FontSize="12" />
            </StackPanel>
            </StackPanel>
    </Grid>
    </ScrollViewer>
    </SplitView>
    <!-- Canvas keeps the branding out of content measurement and scrolling. -->
    <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Border Canvas.Left="-128" Canvas.Top="-112" Width="112" Height="96" Padding="8">
            <HyperlinkButton NavigateUri="https://github.com/umbertotechnopreneur/VibeWare"
                             Padding="0" MinWidth="0" MinHeight="0"
                             AutomationProperties.Name="VibeWare on GitHub">
                <Image Source="ms-appx:///Assets/vibeware-logo.png" Width="96" Stretch="Uniform"
                       AutomationProperties.Name="VibeWare logo" />
            </HyperlinkButton>
        </Border>
    </Canvas>
    </Grid>
</Window>
