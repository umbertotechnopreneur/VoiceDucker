<Window
    x:Class="VoiceDucker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VoiceDucker">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="20" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="VOICEDUCKER" FontFamily="Consolas" FontSize="19" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/vibeware-logo.png" Width="68" Height="68" Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="Your audio, quieter when you speak" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="by Umberto Giacobbi · part of VibeWare" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="Off. Your microphone is not in use." TextWrapping="Wrap" />
            <Button x:Name="ToggleButton" Content="Enable" Click="ToggleButton_Click"
                    HorizontalAlignment="Stretch" MinHeight="42"
                    Background="#346A9C" Foreground="#FFF4DC" />
            <TextBlock Text="Playing audio returns to its previous level when the mic is quiet."
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
