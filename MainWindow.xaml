<Window
    x:Class="VoiceDucker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VoiceDucker">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RootPanel" Padding="22" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border x:Name="MicStatusBorder" Width="42" Height="42" Background="#263B50"
                        BorderBrush="#F6A24C" BorderThickness="1" CornerRadius="2">
                    <Grid>
                        <FontIcon x:Name="MicStatusIcon" Glyph="&#xE720;" FontFamily="Segoe Fluent Icons"
                                  FontSize="22" Foreground="#F6A24C" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="VoiceDucker" FontFamily="Consolas" FontSize="23"
                               FontWeight="Bold" CharacterSpacing="70" />
                    <TextBlock Text="Your audio, quieter when you speak" FontSize="13" Opacity="0.72" />
                </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="164" Height="164">
                    <Grid>
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="MixerScale" CenterX="82" CenterY="82" />
                        </Grid.RenderTransform>
                        <Image x:Name="MixerImage" Source="Assets/voice-mixer-off.png"
                               Stretch="UniformToFill" Opacity="0.65" />
                        <Image x:Name="MixerOnImage" Source="Assets/voice-mixer.png"
                               Stretch="UniformToFill" Opacity="0">
                            <Image.Clip>
                                <RectangleGeometry Rect="62,39,42,21" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <Border x:Name="MicGlow" CornerRadius="12" BorderThickness="3"
                            BorderBrush="#F6A24C" Opacity="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Margin="0,0,0,9" Spacing="3">
                        <Border x:Name="Bar1" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar2" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar3" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar4" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                        <Border x:Name="Bar5" Width="5" Height="6" Background="#F6A24C" CornerRadius="2" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                    <TextBlock x:Name="VisualStateText" Text="MIC OFF" FontFamily="Consolas"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Off. Your microphone is not in use."
                               TextWrapping="Wrap" FontSize="13" />
                    <TextBlock Text="Audio stays on your device." FontSize="12" Opacity="0.65" />
                </StackPanel>
            </Grid>

            <Button x:Name="ToggleButton" Click="ToggleButton_Click"
                    HorizontalAlignment="Stretch" MinHeight="46"
                    Background="#346A9C" Foreground="#FFF4DC">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="ToggleButtonIcon" Glyph="&#xE768;"
                              FontFamily="Segoe Fluent Icons" FontSize="16" />
                    <TextBlock x:Name="ToggleButtonLabel" Text="Enable" />
                </StackPanel>
            </Button>

            <StackPanel Spacing="8">
                <TextBlock Text="AUDIO SETTINGS" FontFamily="Consolas" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Reduce volume by (%)" VerticalAlignment="Center" />
                    <NumberBox x:Name="ReductionBox" Grid.Column="1" Minimum="0" Maximum="100"
                               SmallChange="1" SpinButtonPlacementMode="Compact"
                               ValueChanged="SettingBox_ValueChanged" />
                    <TextBlock Grid.Row="1" Text="Fade down (ms)" VerticalAlignment="Center" />
                    <NumberBox x:Name="FadeDownBox" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="5000"
                               SmallChange="100" SpinButtonPlacementMode="Compact"
                               ValueChanged="SettingBox_ValueChanged" />
                    <TextBlock Grid.Row="2" Text="Fade back (ms)" VerticalAlignment="Center" />
                    <NumberBox x:Name="FadeUpBox" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="30000"
                               SmallChange="100" SpinButtonPlacementMode="Compact"
                               ValueChanged="SettingBox_ValueChanged" />
                </Grid>
                <TextBlock Text="Fade back is the time to return to the previous volume (for example, 10% to 100%)."
                           TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                <CheckBox x:Name="StartupCheckBox" Content="Start with Windows (opens with mic off)"
                          Click="StartupCheckBox_Click" />
                <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="ACTIVE AUDIO STREAMS" FontFamily="Consolas" FontWeight="SemiBold" />
                <CheckBox x:Name="OtherSourcesCheckBox" Content="Also lower other apps"
                          Click="OtherSourcesCheckBox_Click" />
                <TextBlock Text="Spotify is lowered by default. Sliders control each app's Windows audio session."
                           TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                <StackPanel x:Name="StreamRows" Spacing="8" />
                <TextBlock x:Name="NoStreamsText" Text="No apps playing audio right now."
                           FontSize="12" Opacity="0.68" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="About VoiceDucker" Click="AboutButton_Click" />
                <TextBlock Text="VibeWare · by Umberto Giacobbi" Opacity="0.65"
                           VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
