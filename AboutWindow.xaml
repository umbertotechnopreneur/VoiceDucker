<Window
    x:Class="VoiceDucker.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About VoiceDucker">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="AboutPanel" Padding="22" Spacing="14">
            <Grid Height="200" HorizontalAlignment="Center" Width="200">
                <Image Source="Assets/about-banner.png" Stretch="UniformToFill" />
            </Grid>
            <StackPanel HorizontalAlignment="Center" Spacing="3">
                <TextBlock Text="VOICEDUCKER" FontFamily="Consolas" FontSize="22"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="Version" Opacity="0.65"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Music steps back while you speak, then smoothly returns."
                       TextWrapping="Wrap" TextAlignment="Center" />
            <Border Background="#263B50" RequestedTheme="Dark" CornerRadius="10" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Part of VibeWare" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Created by Umberto Giacobbi. Built with AI assistance and accountable human review."
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="Read the VibeWare MANIFESTO ↗"
                                     NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto"
                                     HorizontalAlignment="Left" Padding="0" FontSize="13" />
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <HyperlinkButton Content="VoiceDucker on GitHub ↗"
                                 NavigateUri="https://github.com/umbertotechnopreneur/VoiceDucker"
                                 HorizontalAlignment="Left" Padding="0" FontSize="13" />
                <HyperlinkButton Grid.Row="1" Content="VibeWare on GitHub ↗"
                                 NavigateUri="https://github.com/umbertotechnopreneur/VibeWare"
                                 HorizontalAlignment="Left" Padding="0" FontSize="13" />
                <Button Grid.Column="1" Grid.RowSpan="2" Content="Close"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Close_Click" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
