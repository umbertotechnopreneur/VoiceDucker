<Window
    x:Class="VoiceDucker.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About VoiceDucker">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="AboutPanel" Padding="22" Spacing="14">
            <Grid Height="200" HorizontalAlignment="Center" Width="200">
                <Image Source="Assets/about-banner.png" Stretch="UniformToFill" />
            </Grid>
            <StackPanel HorizontalAlignment="Center" Spacing="3">
                <TextBlock Text="VOICEDUCKER" FontFamily="Consolas" FontSize="22"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="Version" Opacity="0.65"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Focus on your voice. Let your audio step back." TextWrapping="Wrap" TextAlignment="Center" />
            <Border Background="#263B50" RequestedTheme="Dark" CornerRadius="10" Padding="14">
                <StackPanel Spacing="9">
                    <TextBlock Text="This is VibeWare" FontWeight="SemiBold" />
                    <TextBlock Text="I created VoiceDucker with AI assistance. I define the purpose, guide the implementation, and take responsibility for checking functionality, performance, and security."
                               TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="VibeWare is my initiative for building useful software openly with AI. To learn what VibeWare means and why I created it, read the manifesto."
